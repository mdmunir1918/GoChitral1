generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AccountType {
  TOURIST
  TOUR_GUIDE
  HOTEL_OWNER
  ADMIN
  SUPER_ADMIN
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DirectoryStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum PlaceCategory {
  DESTINATION
  NATURAL_ATTRACTION
  HISTORICAL_PLACE
  CULTURAL_PLACE
  VIEWPOINT
  RESTAURANT
  FOOD_SPOT
  OTHER
}

enum ActivityCategory {
  HIKING
  CULTURAL_EXPERIENCE
  WILDLIFE
  ADVENTURE
  WELLNESS
  OTHER
}

enum DirectorySource {
  ADMIN
  PROVIDER
  TOURIST_SUGGESTION
}

enum SavedListingType {
  PLACE
  ACTIVITY
  HOTEL
  GUIDE
}

enum ItineraryItemType {
  PLACE
  ACTIVITY
  HOTEL
  GUIDE
  CUSTOM
}

model User {
  id                 String              @id @default(cuid())
  name               String?
  email              String?             @unique
  emailVerified      DateTime?
  image              String?
  passwordHash       String?
  accountType        AccountType         @default(TOURIST)
  accounts           Account[]
  sessions           Session[]
  passwordResetToken PasswordResetToken?
  guideApplication   GuideApplication?
  guideProfile       GuideProfile?
  hotelApplication   HotelApplication?
  hotelProfile       Hotel?
  placesCreated      Place[]
  activitiesCreated  Activity[]
  placeSuggestions   PlaceSuggestion[]
  touristProfile     TouristProfile?
  savedListings      SavedListing[]
  trips              Trip[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model TouristProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  phone            String?
  homeLocation     String?
  travelInterests  String[] @default([])
  travelStyle      String?
  preferredPace    String?
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model SavedListing {
  id             String           @id @default(cuid())
  userId         String
  type           SavedListingType
  placeId        String?
  activityId     String?
  hotelId        String?
  guideProfileId String?
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  place          Place?           @relation(fields: [placeId], references: [id], onDelete: Cascade)
  activity       Activity?        @relation(fields: [activityId], references: [id], onDelete: Cascade)
  hotel          Hotel?           @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  guideProfile   GuideProfile?    @relation(fields: [guideProfileId], references: [id], onDelete: Cascade)
  createdAt      DateTime         @default(now())

  @@unique([userId, placeId])
  @@unique([userId, activityId])
  @@unique([userId, hotelId])
  @@unique([userId, guideProfileId])
  @@index([userId, createdAt])
}

model Trip {
  id             String              @id @default(cuid())
  userId         String
  title          String              @db.VarChar(120)
  description    String?             @db.Text
  startDate      DateTime            @db.Date
  endDate        DateTime            @db.Date
  archivedAt     DateTime?
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  days           TripDay[]
  accommodations TripAccommodation[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([userId, archivedAt, updatedAt])
}

model TripDay {
  id          String           @id @default(cuid())
  tripId      String
  dayNumber   Int
  date        DateTime         @db.Date
  notes       String?          @db.Text
  trip        Trip             @relation(fields: [tripId], references: [id], onDelete: Cascade)
  items       ItineraryItem[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([tripId, dayNumber])
  @@unique([tripId, date])
  @@index([tripId, dayNumber])
}

model ItineraryItem {
  id             String            @id @default(cuid())
  dayId          String
  type           ItineraryItemType
  title          String            @db.VarChar(180)
  location       String?
  latitude       Float?
  longitude      Float?
  startTime      String?           @db.VarChar(5)
  notes          String?           @db.Text
  priceInformation String?         @db.VarChar(240)
  sortOrder      Int               @default(0)
  placeId        String?
  activityId     String?
  hotelId        String?
  guideProfileId String?
  day            TripDay           @relation(fields: [dayId], references: [id], onDelete: Cascade)
  place          Place?            @relation(fields: [placeId], references: [id], onDelete: Cascade)
  activity       Activity?         @relation(fields: [activityId], references: [id], onDelete: Cascade)
  hotel          Hotel?            @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  guideProfile   GuideProfile?     @relation(fields: [guideProfileId], references: [id], onDelete: Cascade)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([dayId, sortOrder])
}

model TripAccommodation {
  id                    String          @id @default(cuid())
  tripId                String
  hotelId               String?
  roomTypeId            String?
  hotelName             String          @db.VarChar(180)
  location              String
  checkIn               DateTime        @db.Date
  checkOut              DateTime        @db.Date
  roomTypeName          String?         @db.VarChar(120)
  guests                Int?
  notes                 String?         @db.Text
  indicativePricePerNight Decimal?      @db.Decimal(10, 2)
  trip                  Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  hotel                 Hotel?          @relation(fields: [hotelId], references: [id], onDelete: SetNull)
  roomType              HotelRoomType?  @relation(fields: [roomTypeId], references: [id], onDelete: SetNull)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([tripId, checkIn])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String   @unique
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model GuideApplication {
  id                  String            @id @default(cuid())
  userId              String            @unique
  phone               String
  whatsapp            String
  biography           String            @db.Text
  experienceYears     Int
  languages           String[]
  regionsCovered      String[]
  specialties         String[]
  services            String[]
  verificationDetails String            @db.Text
  status              ApplicationStatus @default(PENDING)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  guide               GuideProfile?
}

model GuideProfile {
  id                  String           @id @default(cuid())
  userId              String           @unique
  applicationId       String           @unique
  slug                String           @unique
  name                String
  summary             String           @db.VarChar(240)
  biography           String           @db.Text
  experienceYears     Int
  languages           String[]         @default([])
  regionsCovered      String[]         @default([])
  specialties         String[]         @default([])
  services            String[]         @default([])
  pricingInformation  String?          @db.Text
  phone               String
  whatsapp            String
  user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  application         GuideApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  images              GuideImage[]
  savedListings       SavedListing[]
  itineraryItems     ItineraryItem[]
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([name])
}

model GuideImage {
  id        String      @id @default(cuid())
  guideId   String
  url       String      @db.Text
  altText   String
  sortOrder Int         @default(0)
  guide     GuideProfile @relation(fields: [guideId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@index([guideId, sortOrder])
}

model HotelApplication {
  id                  String            @id @default(cuid())
  userId              String            @unique
  phone               String
  whatsapp            String
  hotelName           String
  hotelLocation       String
  hotelDescription    String            @db.Text
  businessDetails     String            @db.Text
  verificationDetails String            @db.Text
  status              ApplicationStatus @default(PENDING)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  hotel               Hotel?
}

model Hotel {
  id            String          @id @default(cuid())
  userId        String          @unique
  applicationId String          @unique
  slug          String          @unique
  name          String
  summary       String          @db.VarChar(240)
  description   String          @db.Text
  location      String
  latitude      Float?
  longitude     Float?
  phone         String?
  whatsapp      String?
  amenities     String[]        @default([])
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  application   HotelApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  images        HotelImage[]
  roomTypes     HotelRoomType[]
  savedListings SavedListing[]
  itineraryItems ItineraryItem[]
  accommodations TripAccommodation[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([location])
  @@index([name])
}

model HotelImage {
  id        String   @id @default(cuid())
  hotelId   String
  url       String   @db.Text
  altText   String
  sortOrder Int      @default(0)
  hotel     Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([hotelId, sortOrder])
}

model HotelRoomType {
  id             String   @id @default(cuid())
  hotelId        String
  name           String
  description    String   @db.Text
  occupancy      Int
  pricePerNight  Decimal  @db.Decimal(10, 2)
  hotel          Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  tripAccommodations TripAccommodation[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([hotelId, name])
}

model Place {
  id              String          @id @default(cuid())
  slug            String          @unique
  name            String
  category        PlaceCategory
  summary         String          @db.VarChar(240)
  description     String          @db.Text
  location        String
  latitude        Float?
  longitude       Float?
  cuisine         String?
  specialties     String[]        @default([])
  menuInformation String?         @db.Text
  priceRange      String?
  openingHours    String?
  phone           String?
  whatsapp        String?
  contactUrl      String?
  status          DirectoryStatus @default(PENDING)
  source          DirectorySource @default(ADMIN)
  createdById     String?
  createdBy       User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  images          PlaceImage[]
  savedListings   SavedListing[]
  itineraryItems  ItineraryItem[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([status, category, createdAt])
  @@index([location, status])
  @@index([name])
}

model PlaceImage {
  id        String   @id @default(cuid())
  placeId   String
  url       String   @db.Text
  altText   String
  caption   String?
  sortOrder Int      @default(0)
  place     Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([placeId, sortOrder])
}

model Activity {
  id          String           @id @default(cuid())
  slug        String           @unique
  name        String
  category    ActivityCategory
  summary     String           @db.VarChar(240)
  description String           @db.Text
  location    String
  latitude    Float?
  longitude   Float?
  priceRange  String?
  status      DirectoryStatus  @default(PENDING)
  source      DirectorySource  @default(PROVIDER)
  createdById String?
  createdBy   User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  images      ActivityImage[]
  savedListings SavedListing[]
  itineraryItems ItineraryItem[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([status, category, createdAt])
  @@index([location, status])
  @@index([name])
}

model ActivityImage {
  id         String   @id @default(cuid())
  activityId String
  url        String   @db.Text
  altText    String
  caption    String?
  sortOrder  Int      @default(0)
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([activityId, sortOrder])
}

model PlaceSuggestion {
  id          String          @id @default(cuid())
  userId      String
  name        String
  category    PlaceCategory
  location    String
  description String          @db.Text
  status      DirectoryStatus @default(PENDING)
  reviewNote  String?         @db.Text
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

